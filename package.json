{
  "name": "telemach-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check --error-on-warnings src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests"
  },
  "dependencies": {
    "@touch4it/ical-timezones": "^1.9.0",
    "better-sqlite3": "^13.1.1",
    "dotenv": "^18.0.10",
    "grammy": "^1.46.0",
    "ical-generator": "^11.1.3",
    "pino": "^10.4.0",
    "resend": "^6.38.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
